# ==============================================================================
# Smart Retail CRM & POS - Environment Variables Configuration
# ==============================================================================
#
# DUAL-MODE DATA LAYER & AUTHENTICATION:
# 1. Zero-Config Mock Mode (Default for Local Development / Demo):
#    Leave the variables below empty or omit this file completely.
#    The application will immediately use MockRepository & MockAuth with pre-seeded demo accounts:
#      - OWNER: owner@demo.local / owner123
#      - CASHIER: kasir@demo.local / kasir123
#    MockAuth is strictly disabled in production (`NODE_ENV=production`) or when Supabase is configured.
#
# 2. Supabase PostgreSQL Connected Mode (Production):
#    Provide your Supabase project URL, Anon Key, and Service Role Key.
#    Execute `supabase/schema.sql` followed by `supabase/migrations/20261101_auth_rbac_rls.sql`.
# ==============================================================================

# Supabase Project URL (e.g. https://your-project.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Public Anon Key (Used by client / SSR session handling)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (NEVER expose to client; used strictly by server-only admin actions)
SUPABASE_SERVICE_ROLE_KEY=
